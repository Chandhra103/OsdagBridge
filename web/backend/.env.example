# Local development only. Generate and keep a private value for DJANGO_SECRET_KEY.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-private-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional, comma-separated origins if frontend/API are served on separate origins.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=
# Optional SQLite path; defaults to web/backend/db.sqlite3.
# DJANGO_DB_PATH=
